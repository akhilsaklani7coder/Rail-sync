# ==========================================
# RailSync — Environment Configuration Template
# Copy this file to .env or backend/.env and update values for your environment.
# ==========================================

# Flask Server Configuration
FLASK_APP=main.py
FLASK_ENV=development
FLASK_PORT=5001
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# MySQL Database Configuration (InnoDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=railsync_db

# Frontend Application & CORS Configuration
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Optional: Vite Frontend API Proxy target
VITE_API_BASE_URL=/api

